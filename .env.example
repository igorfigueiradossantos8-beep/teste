# ============================================================================
# Advocacia FB — variáveis de ambiente
# Copie este arquivo para .env.local (desenvolvimento) e configure as mesmas
# chaves nas variáveis de ambiente do projeto na Vercel (produção).
# ============================================================================

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
# Nunca exponha a service_role no client. Usada só em Server Actions/Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública da aplicação (usada em redirects de convite/OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar OAuth — Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
